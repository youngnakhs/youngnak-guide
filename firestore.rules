rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function okNick() {
      return request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 16;
    }
    // 1주(ms) 상한 — 비정상적으로 큰 시간 업로드(치팅) 차단
    function okWeekMs(v) { return v is number && v >= 0 && v <= 604800000; }

    // 공개 리더보드: 닉네임 + 주간 순공시간만. 읽기 공개, 본인 문서 생성/수정, 삭제 금지.
    match /leaderboard/{id} {
      allow read: if true;
      allow create, update: if okNick() && okWeekMs(request.resource.data.weekNetMs);
      allow delete: if false;
    }

    // 교사용: 졸음·각성유지율 등. 비밀번호 게이트(UI)로 보호.
    // 주의: Firestore 직접 접근까지는 막지 못함(민감도 낮음, 닉네임만 — 운영상 수용).
    match /students/{id} {
      allow read: if true;
      allow create, update: if okNick();
      allow delete: if false;
    }
  }
}
